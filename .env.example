# ==============================================================================
# SMARTFLOW ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure values before starting the platform
# ==============================================================================

# ─── Flask Server ─────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-jwt-secret
CORS_ORIGINS=http://localhost:3000,https://smartflow.example.com

# ─── Database & Cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smartflow_user:secure_password@localhost:5432/smartflow_db
REDIS_URL=redis://localhost:6379/0

# ─── Storage & Source Adapters ────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
STORAGE_URL=http://localhost:5000/api/v1/content
STORAGE_BUCKET=smartflow-media-bucket

# ─── Google Drive Adapter (Optional) ──────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=your_authorized_folder_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ─── Delivery Engine & Limits ─────────────────────────────────────────────────
CACHE_TTL=3600
PREFETCH_LIMIT=3
MAX_FILE_SIZE=10737418240
WORKER_CONCURRENCY=4
RATE_LIMIT=120/minute
