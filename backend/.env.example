"""
SmartFlow Backend Environment Configuration
Copy to .env and fill in values for your environment.
NEVER commit actual secrets to version control.
"""
# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-different-random-secret-key-in-production

# Database (PostgreSQL for production, SQLite for development)
DATABASE_URL=sqlite:///smartflow_dev.db
# DATABASE_URL=postgresql://username:password@host:5432/smartflow

# Redis (fakeredis fallback enabled in development)
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=true
# Set USE_FAKE_REDIS=false in production with a real Redis server

# Celery (uses Redis by default)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Object Storage (MinIO / S3-compatible)
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=smartflow
# STORAGE_SECURE=false
# STORAGE_URL=http://localhost:9000

# Local Storage (used when USE_LOCAL_STORAGE=true)
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=uploads

# Google Drive Integration (optional)
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Content Limits
MAX_FILE_SIZE=10737418240
PREFETCH_LIMIT=5
MAX_PREFETCH_CONCURRENT=3
CACHE_TTL=300
CONTENT_CACHE_TTL=3600
METADATA_CACHE_TTL=600

# Rate Limiting
RATE_LIMIT=200 per day, 50 per hour

# Workers
WORKER_CONCURRENCY=4

# Media Processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_DURATION=6

# Admin
ADMIN_PASSWORD=SmartFlow@2024!

# Logging
LOG_LEVEL=INFO

# Frontend (set this to your deployed frontend URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
